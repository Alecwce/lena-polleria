---
import { Picture } from "astro:assets";
import { IMAGES } from "../../data/menu";

const count = 18;
const parts = Array.from({ length: count }, () => ({
  left: 6 + Math.random() * 88,
  size: 30 + Math.random() * 80,
  delay: Math.random() * 5,
  dur: 4.5 + Math.random() * 4,
  drift: (Math.random() - 0.5) * 80,
  peak: 0.1 + Math.random() * 0.22,
}));
---

<section
  id="hero-section"
  class="relative h-[100svh] min-h-[680px] w-full overflow-hidden bg-[#1A1A1A]"
>
  <div id="hero-bg-img" class="absolute inset-0 will-change-transform">
    <Picture
      src={IMAGES.hero}
      formats={["avif", "webp"]}
      alt="Pollo a la brasa dorado sobre carbón encendido de algarrobo"
      class="h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(90deg, rgba(26,26,26,.92) 0%, rgba(26,26,26,.55) 45%, rgba(26,26,26,.18) 100%), linear-gradient(0deg, rgba(26,26,26,.95) 0%, rgba(26,26,26,0) 55%)"
  >
  </div>

  <!-- Smoke CSS Particles (0 KB JS required for animation) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    {
      parts.map((p) => (
        <span
          class="smoke-p"
          style={{
            left: `${p.left}%`,
            width: `${p.size}px`,
            height: `${p.size}px`,
            "--dur": `${p.dur}s`,
            "--delay": `${p.delay}s`,
            "--drift": `${p.drift}px`,
            "--peak": `${p.peak}`,
          }}
        />
      ))
    }
  </div>

  <div
    id="hero-text-container"
    class="relative z-10 mx-auto flex h-full max-w-[1400px] flex-col justify-end px-5 pb-28 md:px-10 md:pb-32"
  >
    <div class="hero-anim mb-5 flex flex-wrap items-center gap-3">
      <span
        class="rounded-full border border-[#FFB703]/60 bg-[#FFB703]/10 px-4 py-1.5 font-body text-xs font-bold uppercase tracking-[0.25em] text-[#FFB703]"
      >
        Pollería &amp; Brasas · Lima
      </span>
      <span
        class="rounded-full border border-[#FFF8E8]/25 px-4 py-1.5 font-body text-xs font-bold uppercase tracking-[0.25em] text-[#FFF8E8]/80"
      >
        Desde 1998
      </span>
    </div>

    <h1 class="hero-anim font-display font-bold leading-[0.92] text-[#FFF8E8]">
      <span class="block text-[clamp(2.6rem,9vw,80px)]">El verdadero</span>
      <span class="block text-[clamp(3.4rem,12vw,118px)]">
        Pollo a la{" "}
        <span class="relative inline-block text-[#C41E0A]">
          Brasa
          <svg
            viewBox="0 0 300 24"
            class="absolute -bottom-2 left-0 w-full"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d="M4 16 C 70 4, 150 22, 296 8"
              fill="none"
              stroke="#FFB703"
              stroke-width="6"
              stroke-linecap="round"
            />
          </svg>
        </span>
      </span>
    </h1>

    <p
      class="hero-anim mt-7 max-w-xl font-body text-lg leading-relaxed text-[#FFF8E8]/85 md:text-xl"
    >
      28 años encendiendo el carbón de algarrobo. Piel crocante, carne
      jugosa y ese sabor a leña que se queda en el alma. ¡Habla, causa! 🍗
    </p>

    <div class="hero-anim mt-9 flex flex-wrap items-center gap-4">
      <a
        href="#delivery"
        class="btn-brasa rounded-full px-8 py-4 font-body text-base font-bold"
        aria-label="Ir a la sección de delivery"
      >
        <span class="flame-ico mr-2" aria-hidden="true">🔥</span> Pedir Delivery
      </a>
      <a
        href="#carta"
        class="rounded-full border-2 border-[#FFF8E8]/40 px-8 py-4 font-body text-base font-bold text-[#FFF8E8] transition-all hover:border-[#FFB703] hover:text-[#FFB703]"
        aria-label="Ver el menú completo"
      >
        Ver la carta →
      </a>
    </div>
  </div>

  <!-- bottom marquee strip (0 KB JS required for animation) -->
  <div
    class="absolute bottom-0 left-0 right-0 z-10 overflow-hidden border-y-2 border-[#1A1A1A] bg-[#FFB703] py-3"
    aria-hidden="true"
  >
    <div class="marquee">
      {
        [0, 1].map(() => (
          <div class="flex shrink-0 items-center gap-8 pr-8 font-display text-lg font-bold uppercase tracking-wide text-[#1A1A1A]">
            {[
              "100% Carbón de Algarrobo",
              "Jugoso por dentro",
              "Crocante por fuera",
              "Ají de la casa",
              "Delivery en 30 min",
              "Hecho en Lima 🇵🇪",
            ].map((t) => (
              <span class="flex items-center gap-8">
                {t}
                <span class="text-[#C41E0A]">✦</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import type gsap from "gsap";
  let gsapCtx: ReturnType<typeof gsap.context> | undefined;

  async function initHeroAnimations() {
    const hero = document.getElementById("hero-section");
    const heroImg = document.getElementById("hero-bg-img");
    const heroText = document.getElementById("hero-text-container");

    if (!hero || !heroImg || !heroText) return;

    // Dynamically import GSAP & ScrollTrigger
    const { default: gsap } = await import("gsap");
    const { ScrollTrigger } = await import("gsap/ScrollTrigger");

    gsap.registerPlugin(ScrollTrigger);

    gsapCtx = gsap.context(() => {
      gsap.fromTo(
        heroImg,
        { y: 0, scale: 1.12 },
        {
          y: 210,
          scale: 1.3,
          ease: "none",
          scrollTrigger: {
            trigger: hero,
            start: "top top",
            end: "bottom top",
            scrub: true,
          },
        }
      );

      gsap.to(heroText, {
        y: -90,
        opacity: 0.25,
        ease: "none",
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
      });

      gsap.from(".hero-anim", {
        y: 54,
        opacity: 0,
        duration: 1.1,
        stagger: 0.12,
        ease: "power3.out",
        delay: 0.15,
      });
    }, hero);
  }

  function cleanupHero() {
    if (gsapCtx) {
      gsapCtx.revert();
    }
  }

  document.addEventListener("astro:page-load", initHeroAnimations);
  document.addEventListener("astro:before-preparation", cleanupHero, { once: true });
</script>
