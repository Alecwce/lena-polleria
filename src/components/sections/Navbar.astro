---
const NAV = [
  { label: "Combos", href: "#combos" },
  { label: "La Carta", href: "#carta" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Delivery", href: "#delivery" },
  { label: "Local", href: "#local" },
];
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-transparent py-5"
>
  <div class="mx-auto flex max-w-[1400px] items-center justify-between px-5 md:px-10">
    <a href="#top" class="flex items-center gap-2" aria-label="Volver arriba">
      <span
        class="grid h-10 w-10 place-items-center rounded-full bg-[#C41E0A] text-[#FFF8E8] text-lg shadow-[0_6px_18px_rgba(196,30,10,.4)]"
      >
        🔥
      </span>
      <span
        id="logo-name"
        class="font-display text-2xl font-bold tracking-tight transition-colors text-[#FFF8E8]"
      >
        LA&nbsp;LEÑA
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navegación principal">
      {
        NAV.map((n) => (
          <a
            href={n.href}
            class="nav-link font-body text-[15px] font-medium tracking-wide transition-colors hover:text-[#C41E0A] text-[#FFF8E8]/90"
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <!-- Header Actions (CTA & Mobile Hamburger) -->
    <div class="flex items-center gap-3">
      <a
        href="#delivery"
        class="btn-brasa rounded-full px-4 py-2 sm:px-5 sm:py-2.5 font-body text-xs sm:text-sm font-bold inline-flex"
        aria-label="Pedir delivery ahora"
      >
        <span class="flame-ico mr-1" aria-hidden="true">🔥</span> Pedir ahora
      </a>

      <!-- Mobile Hamburger Toggle -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 text-[#FFF8E8] backdrop-blur transition-colors hover:bg-[#C41E0A] focus:outline-none focus:ring-2 focus:ring-[#FFB703] lg:hidden"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <svg id="burger-icon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Drawer Navigation -->
<div
  id="mobile-menu-drawer"
  class="fixed inset-x-0 top-0 z-40 flex flex-col bg-[#1A1A1A]/98 backdrop-blur-xl px-6 pt-24 pb-8 shadow-2xl transition-all duration-300 -translate-y-full opacity-0 pointer-events-none lg:hidden border-b border-[#FFB703]/20"
  aria-hidden="true"
>
  <nav class="flex flex-col gap-3 text-center" aria-label="Navegación móvil">
    {
      NAV.map((n) => (
        <a
          href={n.href}
          class="mobile-nav-link font-display text-xl font-bold text-[#FFF8E8] py-2 transition-colors hover:text-[#FFB703]"
        >
          {n.label}
        </a>
      ))
    }
  </nav>

  <div class="mt-4 pt-4 border-t border-[#FFF8E8]/10 flex flex-col gap-3">
    <a
      href="#delivery"
      class="mobile-nav-link btn-brasa justify-center rounded-full py-3.5 font-body text-base font-bold text-center"
    >
      <span class="flame-ico mr-2" aria-hidden="true">🛵</span> Pedir Delivery en 30 min
    </a>
    <a
      href="https://wa.me/51999999999?text=Hola%20La%20Le%C3%B1a,%20quisiera%20hacer%20un%20pedido%20a%20domicilio."
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full bg-[#25D366] text-[#FFF8E8] justify-center py-3 font-body text-sm font-bold flex items-center gap-2 hover:bg-[#1ebc57] transition-colors"
    >
      💬 Pedir por WhatsApp
    </a>
  </div>
</div>

<script>
  function initHeader() {
    const header = document.getElementById("main-header");
    const navLinks = document.querySelectorAll(".nav-link");
    const logoName = document.getElementById("logo-name");
    const menuBtn = document.getElementById("mobile-menu-btn");
    const drawer = document.getElementById("mobile-menu-drawer");
    const burgerIcon = document.getElementById("burger-icon");
    const closeIcon = document.getElementById("close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    const onScroll = () => {
      const scrolled = window.scrollY > 40;
      if (header) {
        if (scrolled) {
          header.classList.remove("bg-transparent", "py-5");
          header.classList.add(
            "bg-[#FFF8E8]/95",
            "backdrop-blur",
            "shadow-[0_8px_30px_rgba(74,44,29,.12)]",
            "py-3"
          );
        } else {
          header.classList.remove(
            "bg-[#FFF8E8]/95",
            "backdrop-blur",
            "shadow-[0_8px_30px_rgba(74,44,29,.12)]",
            "py-3"
          );
          header.classList.add("bg-transparent", "py-5");
        }
      }

      if (logoName) {
        if (scrolled) {
          logoName.classList.remove("text-[#FFF8E8]");
          logoName.classList.add("text-[#1A1A1A]");
        } else {
          logoName.classList.remove("text-[#1A1A1A]");
          logoName.classList.add("text-[#FFF8E8]");
        }
      }

      if (menuBtn) {
        if (scrolled) {
          menuBtn.classList.remove("bg-white/10", "text-[#FFF8E8]");
          menuBtn.classList.add("bg-[#1A1A1A]/10", "text-[#1A1A1A]");
        } else {
          menuBtn.classList.remove("bg-[#1A1A1A]/10", "text-[#1A1A1A]");
          menuBtn.classList.add("bg-white/10", "text-[#FFF8E8]");
        }
      }

      navLinks.forEach((link) => {
        if (scrolled) {
          link.classList.remove("text-[#FFF8E8]/90");
          link.classList.add("text-[#4A2C1D]");
        } else {
          link.classList.remove("text-[#4A2C1D]");
          link.classList.add("text-[#FFF8E8]/90");
        }
      });
    };

    const toggleMenu = () => {
      if (!drawer || !menuBtn) return;
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
      const nextState = !isOpen;

      menuBtn.setAttribute("aria-expanded", String(nextState));
      drawer.setAttribute("aria-hidden", String(!nextState));

      if (nextState) {
        drawer.classList.remove("-translate-y-full", "opacity-0", "pointer-events-none");
        drawer.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");
        burgerIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
      } else {
        drawer.classList.add("-translate-y-full", "opacity-0", "pointer-events-none");
        drawer.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
        burgerIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      }
    };

    const closeMenu = () => {
      if (!drawer || !menuBtn) return;
      menuBtn.setAttribute("aria-expanded", "false");
      drawer.setAttribute("aria-hidden", "true");
      drawer.classList.add("-translate-y-full", "opacity-0", "pointer-events-none");
      drawer.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
      burgerIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    };

    menuBtn?.addEventListener("click", toggleMenu);
    mobileLinks.forEach((l) => l.addEventListener("click", closeMenu));

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === "Escape") closeMenu();
    };
    window.addEventListener("keydown", onKeydown);

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    document.addEventListener(
      "astro:before-preparation",
      () => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("keydown", onKeydown);
      },
      { once: true }
    );
  }

  document.addEventListener("astro:page-load", initHeader);
</script>
