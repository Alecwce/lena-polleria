---
import { FAQS } from "../../data/menu";
---

<section id="faq" class="relative bg-[#FFF8E8] py-20 md:py-28">
  <div class="mx-auto max-w-[1200px] px-5 md:px-10">
    <div class="mb-14 text-center">
      <p class="font-body text-sm font-bold uppercase tracking-[0.3em] text-[#C41E0A]">
        Todo Claro Antes de Pedir
      </p>
      <h2 class="mt-3 font-display text-[clamp(2.4rem,5.5vw,56px)] font-bold leading-tight text-[#1A1A1A]">
        Preguntas Frecuentes & Medios de Pago
      </h2>
    </div>

    <!-- Payment Methods Trust Badges -->
    <div class="mb-14 rounded-3xl border border-[#4A2C1D]/15 bg-white p-7 shadow-sm">
      <div class="text-center font-body text-xs font-bold uppercase tracking-widest text-[#4A2C1D]/80 mb-6">
        Aceptamos todos los medios de pago directos y sin recargo
      </div>
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-8 font-display text-base font-bold text-[#1A1A1A]">
        <div class="flex items-center gap-2.5 rounded-2xl bg-[#742284]/10 border border-[#742284]/30 px-5 py-3 text-[#742284]">
          <span class="text-xl">📱</span> Yape
        </div>
        <div class="flex items-center gap-2.5 rounded-2xl bg-[#00BCD4]/10 border border-[#00BCD4]/30 px-5 py-3 text-[#00838F]">
          <span class="text-xl">📱</span> Plin
        </div>
        <div class="flex items-center gap-2.5 rounded-2xl bg-[#1A1F71]/10 border border-[#1A1F71]/30 px-5 py-3 text-[#1A1F71]">
          <span class="text-xl">💳</span> Visa / Mastercard (POS)
        </div>
        <div class="flex items-center gap-2.5 rounded-2xl bg-[#2E7D32]/10 border border-[#2E7D32]/30 px-5 py-3 text-[#2E7D32]">
          <span class="text-xl">💵</span> Efectivo con vuelto
        </div>
      </div>
    </div>

    <!-- FAQ Accordion -->
    <div class="mx-auto max-w-3xl space-y-4">
      {
        FAQS.map((faq) => (
          <details class="group rounded-2xl border border-[#4A2C1D]/15 bg-white p-6 shadow-sm transition-all open:border-[#C41E0A] open:shadow-md">
            <summary class="flex cursor-pointer items-center justify-between font-display text-lg font-bold text-[#1A1A1A] transition-colors group-hover:text-[#C41E0A]">
              <span>{faq.q}</span>
              <span class="ml-4 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-[#FFF8E8] text-[#C41E0A] text-lg font-bold transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-4 font-body text-base leading-relaxed text-[#4A2C1D]/85 border-t border-[#4A2C1D]/10 pt-4">
              {faq.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
