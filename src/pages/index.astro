---
import About from "../components/sections/About.astro";
import Carta from "../components/sections/Carta.astro";
import Combos from "../components/sections/Combos.astro";
import Delivery from "../components/sections/Delivery.astro";
import Footer from "../components/sections/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Local from "../components/sections/Local.astro";
import Navbar from "../components/sections/Navbar.astro";
import SocialProof from "../components/sections/SocialProof.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

// Enable route caching for dev testing or future SSR conversion
if (Astro.cache?.enabled) {
  Astro.cache.set({
    maxAge: 3600, // 3600 seconds (1 hour)
  });
}
---

<BaseLayout
  title="La Leña · El verdadero Pollo a la Brasa en Pueblo Libre, Lima"
  description="28 años encendiendo el carbón de algarrobo. Disfruta de la mejor piel crocante, carne jugosa y el sabor a leña tradicional en Lima. Pide delivery en 30 minutos."
>
  <!-- Scroll progress bar -->
  <div
    id="scroll-progress-bar"
    class="fixed left-0 top-0 z-[60] h-1 w-full origin-left bg-[#C41E0A]"
    style="transform: scaleX(0);"
  >
  </div>

  <Navbar />
  <main id="main-content" tabindex="-1">
    <Hero />
    <SocialProof />
    <Combos />
    <Carta />
    <About />
    <Delivery />
    <Local />
  </main>
  <Footer />

  <!-- Floating order pill for quick delivery action -->
  <a
    id="floating-order-pill"
    href="#delivery"
    class="floating-pill btn-brasa rounded-full px-6 py-3.5 font-body text-sm font-bold"
    aria-label="Pedir delivery ahora"
  >
    <span class="flame-ico mr-2" aria-hidden="true">🛵</span> Pedir ahora
  </a>
</BaseLayout>

<script>
  import type gsap from "gsap";
  let gsapCtx: ReturnType<typeof gsap.context> | undefined;

  async function initScrollProgress() {
    const bar = document.getElementById("scroll-progress-bar");
    if (!bar) return;

    // Dynamically import GSAP & ScrollTrigger
    const { default: gsap } = await import("gsap");
    const { ScrollTrigger } = await import("gsap/ScrollTrigger");

    gsap.registerPlugin(ScrollTrigger);

    gsapCtx = gsap.context(() => {
      gsap.fromTo(
        bar,
        { scaleX: 0 },
        {
          scaleX: 1,
          ease: "none",
          scrollTrigger: {
            start: 0,
            end: "max",
            scrub: 0.4,
          },
        }
      );
    });
  }

  function initFloatingOrder() {
    const pill = document.getElementById("floating-order-pill");
    if (!pill) return;

    const onScroll = () => {
      const show = window.scrollY > 700;
      if (show) {
        pill.classList.add("show");
      } else {
        pill.classList.remove("show");
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    document.addEventListener(
      "astro:before-preparation",
      () => {
        window.removeEventListener("scroll", onScroll);
      },
      { once: true }
    );
  }

  function cleanupIndex() {
    if (gsapCtx) {
      gsapCtx.revert();
    }
  }

  document.addEventListener("astro:page-load", () => {
    initScrollProgress();
    initFloatingOrder();
  });
  document.addEventListener("astro:before-preparation", cleanupIndex, { once: true });
</script>
